# ==============================================================================
# নয়া বাংলা (Noya Bangla) - Environment Configuration Template
# ==============================================================================

# PostgreSQL Connection String (Hostinger VPS / Local Docker)
DATABASE_URL="postgresql://postgres:postgres_secure_2026@localhost:5432/bangla_news"

# PostgreSQL Container Credentials (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_2026
POSTGRES_DB=bangla_news

# Redis Cache Connection
REDIS_URL="redis://localhost:6379"

# Public Site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret Key for JWT / Session Tokens (Generate with: openssl rand -base64 32)
AUTH_SECRET="change-this-in-production-to-a-secure-random-string-2026"

# Node Environment
NODE_ENV="development"
